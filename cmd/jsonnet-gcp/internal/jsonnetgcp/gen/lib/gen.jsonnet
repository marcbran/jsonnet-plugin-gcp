local generateLib = import 'generate.libsonnet';
local mixins = importstr 'mixins.libsonnet';
local treeLib = import 'tree.libsonnet';

local packageName(service) = 'arcourse-gcp-' + service;

local pkg(service, title) = |||
  local p = import 'pkg/main.libsonnet';

  p.pkg({
    source: 'https://github.com/marcbran/jsonnet-plugin-gcp/tree/main/services/%(service)s/arcourse',
    repo: 'https://github.com/marcbran/jsonnet.git',
    branch: 'arcourse/gcp/%(name)s',
    path: 'arcourse/gcp/%(name)s',
    target: '%(name)s',
    external: ['root', 'arcourse-ui/main.libsonnet'],
  }, |||
    Arcourse nodes for %(title)s, below `gcp/$project/%(service)s`.

    Generated by jsonnet-gcp from the plugin's Discovery document and the resources and columns
    in ../inference. The project nodes come from arcourse-gcp.
  |||, {})
||| % {
  service: service,
  name: packageName(service),
  title: title,
};

function(service, model, resources, columns)
  local tree = treeLib {
    model:: model,
    overrides:: resources,
    columns:: columns,
  };
  {
    'main.libsonnet': generateLib {
      service:: service,
      tree:: tree,
    }.jsonnet,
    'pkg.libsonnet': pkg(service, tree.service.title),
    'mixins.libsonnet': mixins,
  }
