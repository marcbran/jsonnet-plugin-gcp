tool := "go tool -modfile=../../tools/go.mod"

test-go:
    go test ./...

test-jsonnet:
    {{tool}} jpoet test .

test: test-go test-jsonnet

lint:
    {{tool}} golangci-lint run ./...

build:
    go build -o jsonnet-gcp .

install:
    dest=$(go env GOBIN); [ -n "$dest" ] || dest=$(go env GOPATH)/bin; go build -o "$dest/jsonnet-gcp" .

test-e2e:
    JSONNET_GCP_BINARY="$(pwd)/jsonnet-gcp" go test -v -tags e2e ./tests/...

ci: lint test build test-e2e
